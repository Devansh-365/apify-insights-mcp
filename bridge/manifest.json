{
    "manifest_version": 3,
    "name": "Apify Insights Bridge",
    "version": "0.1.0",
    "description": "Keeps the apify-insights-mcp server connected to your own Apify Console session. Talks only to console-backend.apify.com and the local native host.",
    "key": "",
    "permissions": ["alarms", "nativeMessaging", "storage"],
    "host_permissions": ["https://console-backend.apify.com/*"],
    "background": { "service_worker": "sw.js" }
}
