{
  "name": "apify-insights-mcp",
  "version": "0.1.0",
  "description": "MCP server that answers an Apify creator's questions about their own actors: health, users, pricing and (later) revenue.",
  "type": "module",
  "bin": {
    "apify-insights-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
