{
  "name": "apify-insights-mcp",
  "version": "0.5.0",
  "description": "MCP server that answers an Apify creator's questions about their own actors: revenue, profit, health, users, pricing and Store rank.",
  "author": "Devansh Tiwari",
  "type": "module",
  "bin": {
    "apify-insights-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bridge/manifest.json",
    "bridge/sw.js",
    "bridge/EXTENSION_ID"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devansh-365/apify-insights-mcp.git"
  },
  "homepage": "https://github.com/Devansh-365/apify-insights-mcp#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "apify",
    "claude",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "grok"
  ]
}
